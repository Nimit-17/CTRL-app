# LLM providers (both free tier). Gemini is primary, Groq is automatic failover.
GEMINI_API_KEY=        # from aistudio.google.com — free tier, do NOT enable billing
GROQ_API_KEY=          # from console.groq.com — free tier

# Web push (run once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@nimit.site

# Optional single shared secret. If set, all /api requests must send
# the X-Owner-Token header with this value. Leave blank to disable.
OWNER_TOKEN=

PORT=8787
